# Keycloak Configuration
KEYCLOAK_URL=http://localhost:8080
KEYCLOAK_REALM=master
KEYCLOAK_CLIENT_ID=fastapi-client
KEYCLOAK_CLIENT_SECRET=your-client-secret-here
KEYCLOAK_ADMIN_USERNAME=admin
KEYCLOAK_ADMIN_PASSWORD=admin

# GitHub Configuration
GITHUB_TOKEN=your-github-token-here
GITHUB_USERNAME=your-github-username
GITHUB_EMAIL=your-github-email

# Database Configuration
DB_HOST=localhost
DB_PORT=5432
DB_USER=user
DB_PASSWORD=password
DB_NAME=mydatabase
DATABASE_URL=postgresql://user:password@localhost:5432/mydatabase

# Superset Configuration
SUPERSET_URL=http://localhost:8088
SUPERSET_USER=admin
SUPERSET_PASSWORD=your-superset-password-here
SUPERSET_SECRET_KEY=your-superset-secret-key-here
SUPERSET_ADMIN_ROLE_ID=1
SUPERSET_GAMMA_ROLE_ID=2

# Application Configuration
API_PREFIX=/api/v1
SECRET_KEY=your-secret-key-here
ALGORITHM=HS256
TOKEN_EXPIRY_MINUTES=30

# Initial Users Configuration
ADMIN_USERNAME=admin
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=admin123
ADMIN_ROLE=admin

USER_USERNAME=user
USER_EMAIL=user@example.com
USER_PASSWORD=user123
USER_ROLE=user
